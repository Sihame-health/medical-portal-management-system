<Window x:Class="MedicalSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion - Systeme Medical"
        Height="520"
        Width="450"
        MinHeight="480"
        MinWidth="380"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="MaxWidth" Value="520"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18" Color="Gray"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="InputPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#0D5C63"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.92"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.82"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Style="{StaticResource CardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="16">
            <StackPanel>
                <TextBlock Text="Systeme Medical"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#0D5C63"
                           TextWrapping="Wrap"/>
                <TextBlock Text="Connexion"
                           FontSize="14"
                           Foreground="#666"
                           Margin="0,6,0,12"
                           TextWrapping="Wrap"/>
                <TextBlock Text="Identifiant" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="IdTextBox" Style="{StaticResource InputTextBoxStyle}" TabIndex="0"/>
                <TextBlock Text="Mot de passe" Style="{StaticResource LabelStyle}"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPasswordStyle}" TabIndex="1"/>
                <TextBlock Text="Role" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="RoleComboBox" Style="{StaticResource ComboBoxStyle}" TabIndex="2">
                    <ComboBoxItem Content="Medecin"/>
                    <ComboBoxItem Content="Infirmier"/>
                    <ComboBoxItem Content="Pharmacie"/>
                    <ComboBoxItem Content="Administrateur"/>
                    <ComboBoxItem Content="Accueil"/>
                </ComboBox>
                <TextBlock x:Name="ErrorMessage"
                           Foreground="#DC3545"
                           Margin="0,10,0,0"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>
                <Button Content="Se connecter "
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,16,0,0"
                        Click="LoginButton_Click"
                        TabIndex="3"/>
                <TextBlock Text="Astuce: utilisez Tab pour naviguer, Entree pour valider."
                           FontSize="11"
                           Foreground="#888"
                           Margin="0,14,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
