<Window x:Class="MedicalSystem.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MedicalSystem"
        xmlns:converters="clr-namespace:MedicalSystem.Converters"
        Title="Administration - Systeme Medical"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        MinHeight="500"
        MinWidth="800"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Converters -->
        <converters:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter"/>
        <converters:StatusToBadgeBackgroundConverter x:Key="StatusToBadgeBackgroundConverter"/>
        <converters:StatusToBadgeForegroundConverter x:Key="StatusToBadgeForegroundConverter"/>
        <!-- REMOVED: ServiceToForegroundConverter -->

        <!-- Reusable wrapping text style -->
        <Style x:Key="WrapCellText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Badge style -->
        <Style x:Key="StatusBadgeBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- DataGrid Style (better UX + wrapping rows) -->
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEE"/>
            <Setter Property="VerticalGridLinesBrush" Value="#EEE"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>

            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="Auto"/>
                        <Setter Property="MinHeight" Value="32"/>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stat Cards (min/max + responsive wrap) -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="MinHeight" Value="100"/>
            <Setter Property="MaxWidth" Value="260"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Card Style for general sections -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
        </Style>

        <!-- Responsive Button Base -->
        <Style x:Key="ResponsiveButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="MaxWidth" Value="180"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.TextAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.92"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.82"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" BasedOn="{StaticResource ResponsiveButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#0D5C63"/>
        </Style>

        <Style x:Key="SecondaryButton" BasedOn="{StaticResource ResponsiveButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#17A2B8"/>
        </Style>

        <Style x:Key="SuccessButton" BasedOn="{StaticResource ResponsiveButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#28A745"/>
        </Style>

        <Style x:Key="InfoButton" BasedOn="{StaticResource ResponsiveButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#6C757D"/>
        </Style>

        <Style x:Key="WarningButton" BasedOn="{StaticResource ResponsiveButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#212529"/>
        </Style>

        <Style x:Key="DangerButton" BasedOn="{StaticResource ResponsiveButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#DC3545"/>
        </Style>

        <!-- Style for Reset Buttons (larger width) -->
        <Style x:Key="LargeDangerButton" BasedOn="{StaticResource DangerButton}" TargetType="Button">
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="97*"/>
            <ColumnDefinition Width="178*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0D5C63" Grid.ColumnSpan="2">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="20" Foreground="White" Margin="10,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="Administration" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Raccourcis: Ctrl+1/2/3/4, echap" FontSize="10" Foreground="#D6F2F5"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="🚪 Deconnexion"
                        Style="{StaticResource SecondaryButton}"
                        Click="LogoutButton_Click"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="8,8,8,8" Grid.ColumnSpan="2">
            <TabControl x:Name="MainTabControl"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        Background="White"
                        SelectionChanged="MainTabControl_SelectionChanged">

                <!-- TAB 1: Users -->
                <TabItem Header="👥 Utilisateurs">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0"
                                   HorizontalAlignment="Right"
                                   Margin="8">
                            <Button Content="➕ Ajouter (Ctrl+N)"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="AddUserButton_Click"/>
                            <Button Content="📥 Importer (Ctrl+I)"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ImportUsersButton_Click"/>
                            <Button Content="📤 Exporter (Ctrl+S)"
                                    Style="{StaticResource SuccessButton}"
                                    Click="ExportUsersButton_Click"/>
                            <Button Content="🔄 Actualiser (Ctrl+R)"
                                    Style="{StaticResource InfoButton}"
                                    Click="RefreshUsersButton_Click"/>
                        </WrapPanel>

                        <DataGrid x:Name="UsersDataGrid"
                                  Grid.Row="1"
                                  Style="{StaticResource DataGridStyle}"
                                  Margin="8">
                            <DataGrid.Columns>

                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>

                                <DataGridTextColumn Header="Nom" Binding="{Binding LastName}" Width="120" MinWidth="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Prenom" Binding="{Binding FirstName}" Width="120" MinWidth="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220" MinWidth="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="120" MinWidth="100"/>

                                <!-- Colonne Service avec style conditionnel -->
                                <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="150" MinWidth="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ServiceName}" Value="{x:Null}">
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                    <Setter Property="Text" Value="(Non assigné)"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ServiceName}" Value="">
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                    <Setter Property="Text" Value="(Non assigné)"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Status badge -->
                                <DataGridTemplateColumn Header="Statut" Width="100" MinWidth="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusBadgeBorder}"
                                                    Background="{Binding Status, Converter={StaticResource StatusToBadgeBackgroundConverter}}">
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToBadgeForegroundConverter}}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Derniere connexion" Binding="{Binding LastLogin}" Width="150" MinWidth="130"/>

                                <DataGridTemplateColumn Header="Actions" Width="170" MinWidth="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✏️"
                                                        ToolTip="Modifier"
                                                        Width="34" Height="28"
                                                        Background="#FFC107"
                                                        Foreground="#212529"
                                                        BorderThickness="0"
                                                        Margin="2"
                                                        Cursor="Hand"
                                                        Tag="{Binding Id}"
                                                        Click="EditUserButton_Click"/>

                                                <Button Content="🔒"
                                                        ToolTip="Reinitialiser MDP"
                                                        Width="34" Height="28"
                                                        Background="#17A2B8"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Margin="2"
                                                        Cursor="Hand"
                                                        Tag="{Binding Id}"
                                                        Click="ResetPasswordButton_Click"/>

                                                <Button Content="✅"
                                                        ToolTip="Activer"
                                                        Width="34" Height="28"
                                                        Background="#28A745"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Margin="2"
                                                        Cursor="Hand"
                                                        Tag="{Binding Id}"
                                                        Click="ActivateUserButton_Click"
                                                        Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=Activate}"/>

                                                <Button Content="❌"
                                                        ToolTip="Desactiver"
                                                        Width="34" Height="28"
                                                        Background="#DC3545"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Margin="2"
                                                        Cursor="Hand"
                                                        Tag="{Binding Id}"
                                                        Click="DeactivateUserButton_Click"
                                                        Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=Deactivate}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- TAB 2: Services -->
                <TabItem Header="🏥 Services">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <Button Content="➕ Ajouter Service"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="AddServiceButton_Click"/>
                        </WrapPanel>

                        <DataGrid x:Name="ServicesDataGrid"
                                  Grid.Row="1"
                                  Style="{StaticResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="180" MinWidth="140"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="260">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Medecins" Binding="{Binding DoctorCount}" Width="90" MinWidth="80"/>

                                <DataGridTemplateColumn Header="Statut" Width="110" MinWidth="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusBadgeBorder}"
                                                    Background="{Binding Status, Converter={StaticResource StatusToBadgeBackgroundConverter}}">
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToBadgeForegroundConverter}}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- TAB 3: Medications -->
                <TabItem Header="💊 Medicaments">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <Button Content="➕ Ajouter"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="AddMedicationButton_Click"/>
                            <Button Content="📥 Importer"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ImportMedicationsButton_Click"/>
                        </WrapPanel>

                        <DataGrid x:Name="MedicationsDataGrid"
                                  Grid.Row="1"
                                  Style="{StaticResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" MinWidth="80"/>
                                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="160" MinWidth="140"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="260">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Quantite" Binding="{Binding Quantity}" Width="90" MinWidth="80"/>
                                <DataGridTextColumn Header="Seuil" Binding="{Binding MinThreshold}" Width="80" MinWidth="70"/>
                                <DataGridTextColumn Header="Expiration" Binding="{Binding ExpirationDate, StringFormat=dd/MM/yyyy}" Width="120" MinWidth="110"/>

                                <DataGridTemplateColumn Header="Statut" Width="130" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusBadgeBorder}"
                                                    Background="{Binding Status, Converter={StaticResource StatusToBadgeBackgroundConverter}}">
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToBadgeForegroundConverter}}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- TAB 4: Dashboard -->
                <TabItem Header="📊 Tableau de bord">
                    <ScrollViewer x:Name="DashboardScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Responsive cards -->
                            <WrapPanel Grid.Row="0" Margin="0,0,0,14">
                                <Border Style="{StaticResource StatCardStyle}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="👥" FontSize="22" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Utilisateurs" FontSize="11" Foreground="#666"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="UsersCountText" Text="0" FontSize="24" FontWeight="Bold"
                                                   Foreground="#0D5C63" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCardStyle}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="🏥" FontSize="22" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Services" FontSize="11" Foreground="#666"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="ServicesCountText" Text="0" FontSize="24" FontWeight="Bold"
                                                   Foreground="#0D5C63" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCardStyle}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="💊" FontSize="22" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Medicaments" FontSize="11" Foreground="#666"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="MedicationsCountText" Text="0" FontSize="24" FontWeight="Bold"
                                                   Foreground="#0D5C63" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCardStyle}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="⚠️" FontSize="22" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Alertes" FontSize="11" Foreground="#666"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="AlertsCountText" Text="0" FontSize="24" FontWeight="Bold"
                                                   Foreground="#DC3545" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Recent activities -->
                            <Border Grid.Row="1"
                                    Background="White"
                                    BorderBrush="#DDD"
                                    BorderThickness="1"
                                    Padding="12"
                                    CornerRadius="10"
                                    Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="📈 Activites recentes"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#0D5C63"
                                               Margin="0,0,0,10"/>

                                    <DataGrid x:Name="ActivitiesDataGrid"
                                              Style="{StaticResource DataGridStyle}"
                                              MaxHeight="280"
                                              MinHeight="160">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Date/Heure" Binding="{Binding DateTime, StringFormat=dd/MM/yyyy HH:mm}" Width="160" MinWidth="140"/>
                                            <DataGridTextColumn Header="Utilisateur" Binding="{Binding User}" Width="160" MinWidth="140"/>
                                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="220" MinWidth="180"/>
                                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" MinWidth="220">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- RESET SYSTEM SECTION (moved to after activities) -->
                            <Border Grid.Row="2"
                                    Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="🔄 Réinitialisation du Système"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#0D5C63"
                                               Margin="0,0,0,10"/>

                                    <TextBlock Text="Cette action supprimera TOUTES les données de test (patients, prescriptions, activités, notifications) mais gardera les utilisateurs, services et médicaments."
                                               FontSize="12"
                                               Foreground="#666"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,15"/>

                                    <WrapPanel>
                                        <Button Content="🗑️ Réinitialiser données de test"
                                                Style="{StaticResource LargeDangerButton}"
                                                Click="ResetTestDataButton_Click"
                                                ToolTip="Supprime patients, prescriptions, activités, notifications"/>

                                        <Button Content="🔁 Réinitialiser COMPLÈTE"
                                                Style="{StaticResource LargeDangerButton}"
                                                Click="ResetAllDataButton_Click"
                                                ToolTip="Remet TOUT à zéro (sauf utilisateurs admin)"/>
                                    </WrapPanel>

                                    <TextBlock Text="⚠️ Attention: Ces actions sont irréversibles!"
                                               FontSize="10"
                                               Foreground="Red"
                                               FontWeight="Bold"
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="#F8F9FA"
                BorderBrush="#DDD"
                BorderThickness="0,1,0,0"
                Padding="8" Grid.ColumnSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Systeme de Gestion Medicale 2025"
                           FontSize="10"
                           Foreground="#666"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           x:Name="LastUpdateText"
                           Text="Derniere mise a jour: --"
                           FontSize="10"
                           Foreground="#666"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Grid>
        </Border>

    </Grid>
</Window>