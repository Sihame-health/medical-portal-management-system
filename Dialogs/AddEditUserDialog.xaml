<Window x:Class="MedicalSystem.AddEditMedicationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Ajouter/Modifier Medicament"
        Height="613"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Code:"/>
            <TextBox x:Name="CodeTextBox"/>

            <TextBlock Text="Nom:"/>
            <TextBox x:Name="NameTextBox"/>

            <TextBlock Text="Description:"/>
            <TextBox x:Name="DescriptionTextBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>

            <TextBlock Text="Quantite:"/>
            <TextBox x:Name="QuantityTextBox"/>

            <TextBlock Text="Seuil minimum:"/>
            <TextBox x:Name="MinThresholdTextBox"/>

            <TextBlock Text="Date d'expiration:"/>
            <DatePicker x:Name="ExpirationDatePicker" SelectedDate="{x:Static sys:DateTime.Now}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="SaveButton" Content="Enregistrer" Click="SaveButton_Click"/>
                <Button Content="Annuler" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
